{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheLakeBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::${bucket}"
    },
    {
      "Sid": "ReadAndWriteTheLakeLayers",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::${bucket}/raw/*",
        "arn:aws:s3:::${bucket}/processed/*",
        "arn:aws:s3:::${bucket}/curated/*",
        "arn:aws:s3:::${bucket}/_state/*",
        "arn:aws:s3:::${bucket}/_athena-results/*"
      ]
    },
    {
      "Sid": "QueryInTheProjectWorkgroup",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup"
      ],
      "Resource": "arn:aws:athena:${region}:${account_id}:workgroup/br-flights"
    },
    {
      "Sid": "ReadTheDefaultCatalog",
      "Effect": "Allow",
      "Action": ["athena:GetDataCatalog"],
      "Resource": "arn:aws:athena:${region}:${account_id}:datacatalog/AwsDataCatalog"
    },
    {
      "Sid": "PublishFailureAlerts",
      "Effect": "Allow",
      "Action": ["sns:Publish"],
      "Resource": "arn:aws:sns:${region}:${account_id}:br-flights-alerts"
    },
    {
      "Sid": "ManageTheProjectTables",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:CreateDatabase",
        "glue:GetTable",
        "glue:GetTables",
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:DeleteTable",
        "glue:GetTableVersions",
        "glue:DeleteTableVersion",
        "glue:BatchDeleteTableVersion",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:BatchGetPartition",
        "glue:CreatePartition",
        "glue:BatchCreatePartition",
        "glue:UpdatePartition",
        "glue:BatchUpdatePartition",
        "glue:DeletePartition",
        "glue:BatchDeletePartition"
      ],
      "Resource": [
        "arn:aws:glue:${region}:${account_id}:catalog",
        "arn:aws:glue:${region}:${account_id}:database/br_flights",
        "arn:aws:glue:${region}:${account_id}:database/br_flights_processed",
        "arn:aws:glue:${region}:${account_id}:database/br_flights_curated",
        "arn:aws:glue:${region}:${account_id}:table/br_flights/*",
        "arn:aws:glue:${region}:${account_id}:table/br_flights_processed/*",
        "arn:aws:glue:${region}:${account_id}:table/br_flights_curated/*"
      ]
    }
  ]
}
