# Copy this file to .env and fill in your own values.

# S3 bucket that holds the data lake; bucket names are global, so pick your own
LAKE_BUCKET=your-bucket-name

# Region of the lake, read by boto3 in every script
AWS_DEFAULT_REGION=us-east-1

# AWS CLI profile that boto3 uses (for example, one created with aws configure sso).
# Left commented, boto3 uses the default credentials: environment variables or
# the default profile.
# AWS_PROFILE=your-profile
